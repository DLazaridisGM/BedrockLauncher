<Page x:Class="BedrockLauncher.Pages.Welcome.WelcomePageTwo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BedrockLauncher.Pages.Welcome"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WelcomePageTwo" Width="596" Height="254">
    <Grid Margin="0" Background="{x:Null}">
        <Border Background="#FF313131" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,55" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
            <TextBlock Visibility="Visible" HorizontalAlignment="Center"  Text="Important Notice" Foreground="White" FontFamily="/BedrockLauncher;component/Resources/fonts/#Noto Sans" FontSize="24" Margin="0,30,0,0" FontWeight="Bold"/>
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Text="Bedrock Launcher DOES NOT help you pirate Minecraft in any way!&#x0a;&#x0a;It is an unofficial utility tool for version management,&#x0a;and you need to own a legally purchased copy of Minecraft for Windows&#x0a;or have an active Xbox Game Pass subscription associated with&#x0a;your Microsoft account to use it." Foreground="White" FontFamily="/BedrockLauncher;component/Resources/fonts/#Noto Sans" FontSize="14" Margin="28.5,15,28.5,20" TextWrapping="Wrap"/>
        </StackPanel>
        <CheckBox x:Name="Acknowledge" VerticalAlignment="Bottom" Margin="0,0,0,19" IsChecked="False" HorizontalAlignment="Center" Foreground="White">
            <StackPanel VerticalAlignment="Center" Margin="0,2,0,0">
                <TextBlock Text="Acknowledge"></TextBlock>
            </StackPanel>
        </CheckBox>
        <StackPanel Margin="0,0,8,8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <Button x:Name="BackButton" Click="BackButton_Click" SnapsToDevicePixels="True" Foreground="White" Content="{DynamicResource FirstLaunch_BackButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="32" Style="{DynamicResource DialogButton}"/>
            <Button x:Name="NextButton" IsEnabled="{Binding ElementName=Acknowledge, Path=IsChecked}" Click="NextButton_Click" SnapsToDevicePixels="True" Foreground="White" Content="{DynamicResource FirstLaunch_NextButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="auto" Height="32" Style="{DynamicResource DialogButton}"/>
        </StackPanel>
    </Grid>
</Page>
